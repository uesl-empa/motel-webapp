<https://digicities.info/ontology/motel-db#controlled_vocabulary/carrier/CAR_00001>
    a dici_onto:EnergyCarrier ;
    mdb:carrier_id "CAR_00001" ;
    mdb:carrier_name "NH3" ;
    mdb:carrier_description "Ammonia (NH3) is a colorless, pungent gas with a molecular weight of 17.03 g/mol. Standard purity constraints typically require 99.5% minimum purity for industrial applications. It is composed of one nitrogen atom and three hydrogen atoms, and is commonly stored and transported as a liquid under high pressure or low temperature. Infrastructure context requires corrosion-resistant materials due to its reactivity with metals." ;
    mdb:carrier_type "other" ;
    mdb:carrier_category "synthetic" .

