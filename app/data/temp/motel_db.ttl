@prefix mdb: <https://digicities.info/ontology/motel-db#> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00001>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00001" ;
    mdb:attribute_name "trl" ;
    mdb:attribute_description "Technology Readiness Level indicating the maturity of a technology on a 1–9 scale, where 1 represents basic research and 9 indicates full system deployment. Defines the technological maturity stage and associated engineering benchmarks." ;
    mdb:unit "—" ;
    mdb:data_format "int" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00002>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00002" ;
    mdb:attribute_name "tech_maturity" ;
    mdb:attribute_description "Aggregated maturity classification derived from TRL, with allowed values: Prototype, Emerging, Mature. Updated annually per tech_year as per Nomenclature 4.2." ;
    mdb:data_format "text" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00003>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00003" ;
    mdb:attribute_name "technical_efficiency" ;
    mdb:attribute_description "Overall energy conversion efficiency calculated as the ratio of main output energy to main input energy, with operational bounds defined by 0 < η ≤ 1. Accounting lines include quantified input and output energy flows, while engineering definitions align with energy carrier-specific metrics (kWh for electricity/heat, LHV for chemical fuels)." ;
    mdb:unit "dimensionless ratio" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00004>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00004" ;
    mdb:attribute_name "theoretical_efficiency" ;
    mdb:attribute_description "Ratio of the main outputs energy content (LHV) to the main inputs energy content (LHV) at theoretical maximum, representing a dimensionless efficiency value bounded between 0 and 1. May be left blank if not applicable to the entity." ;
    mdb:unit "unitless" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00005>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00005" ;
    mdb:attribute_name "operating_temperature_c" ;
    mdb:attribute_description "Defines the operational temperature range for the core process, including mathematical bounds, accounting lines, and engineering specifications relevant to thermal integration." ;
    mdb:unit "°C" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00006>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00006" ;
    mdb:attribute_name "lifetime_yr" ;
    mdb:attribute_description "Expected operational lifetime in years, used for accounting and engineering calculations, defining the period over which the asset is expected to function economically." ;
    mdb:unit "year" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00007>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00007" ;
    mdb:attribute_name "capex_one_time" ;
    mdb:attribute_description "Fixed one-time capital expenditure independent of installed capacity. Must be a non-negative value. Represents a per-project lump sum, typically used for initial setup costs, feasibility studies, or other one-off expenses not tied to the scale of the project. Accounting lines may include capitalization, depreciation, and project-specific cost allocations. Engineering definitions require clear scope and deliverables to ensure accurate budgeting and tracking." ;
    mdb:unit "USD" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00008>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00008" ;
    mdb:attribute_name "opex_one_time" ;
    mdb:attribute_description "Fixed one-time operational expenditure, independent of capacity. Defines the mathematical boundaries, accounting lines, and engineering specifications for OPEX One-Time costs." ;
    mdb:unit "USD" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00009>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00009" ;
    mdb:attribute_name "opex_fix_pct_of_capex" ;
    mdb:attribute_description "Fixed annual operational expenditure expressed as a percentage of total CAPEX, defining the mathematical bounds, accounting lines, and engineering definitions related to this metric." ;
    mdb:unit "%" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00010>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00010" ;
    mdb:attribute_name "opex_per_capacity_yr" ;
    mdb:attribute_description "Fixed annual operational expenditure per unit of installed capacity, excluding fuel costs. This value represents the cost in currency per kilowatt of capacity per year, used for capacity planning and cost analysis. It includes all fixed operational expenses such as maintenance, labor, and administrative costs, but excludes variable costs and fuel expenses." ;
    mdb:unit "USD/kW" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00011>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00011" ;
    mdb:attribute_name "opex_per_energy" ;
    mdb:attribute_description "Detailed description defining operational math bounds, accounting lines, and engineering definitions." ;
    mdb:unit "USD/kWh" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00012>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00012" ;
    mdb:attribute_name "min_installation_size" ;
    mdb:attribute_description "Defines the smallest assumed unit capacity for the technology, specifying operational mathematical boundaries, accounting line items, and engineering definitions. A value of 0 indicates no minimum constraint." ;
    mdb:unit "kW" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00013>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00013" ;
    mdb:attribute_name "uncertainty_rating" ;
    mdb:attribute_description "Qualitative uncertainty rating for the techno-economic parameters." ;
    mdb:unit "—" ;
    mdb:data_format "text" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00014>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00014" ;
    mdb:attribute_name "discount_rate_pct" ;
    mdb:attribute_description "Technology-specific weighted average cost of capital for annualising capital expenditure, defining operational mathematical bounds, accounting lines, and engineering definitions for discount rate calculations." ;
    mdb:unit "%" ;
    mdb:data_format "float" .

<https://digicities.info/ontology/motel-db#controlled_vocabulary/attribute/ATTR_00015>
    a dici_onto:Attribute ;
    mdb:attribute_id "ATTR_00015" ;
    mdb:attribute_name "reference_unit_size" ;
    mdb:attribute_description "The nameplate capacity serving as the foundation for scaling specific cost and performance data, encompassing operational mathematical boundaries, accounting line items, and engineering definitions." ;
    mdb:unit "MW" ;
    mdb:data_format "float" .

